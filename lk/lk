write_default_vhost() {
  local kind="$1" url="${2:-}" f="$APACHE_AV/000-default.conf"
  [[ -f $f && ! -f $f.lk-bak ]] && cp "$f" "$f.lk-bak"
  {
    echo "# Site padrão do servidor - gerado por LK em $(date '+%F %T')"
    echo "<VirtualHost *:80>"
    echo "    ServerName default.localhost"
    echo "    DocumentRoot $DEFAULT_ROOT"
    case $kind in
      html)
        echo "    DirectoryIndex index.html index.php"
        echo "    <Directory $DEFAULT_ROOT>"
        echo "        Options -Indexes"
        echo "        AllowOverride None"
        echo "        Require all granted"
        echo "    </Directory>";;
      redirect)
        echo "    Redirect 302 / $url";;
      deny)
        echo "    <Location />"
        echo "        Require all denied"
        echo "    </Location>";;
    esac
    echo "    ErrorLog \${APACHE_LOG_DIR}/default_error.log"
    echo "    CustomLog \${APACHE_LOG_DIR}/default_access.log combined"
    echo "</VirtualHost>"
  } > "$f"
}

create_default_page() {
  local mode="${1:-}" root="$DEFAULT_ROOT" apache=1 kind=1 t msg url
  if [[ ! -d /etc/apache2 ]]; then
    if is_aapanel && [[ -f /www/server/panel/vhost/apache/0.default.conf ]]; then
      root=$(grep -m1 -i 'DocumentRoot' /www/server/panel/vhost/apache/0.default.conf | awk '{print $2}' | tr -d '"')
      apache=0
      info "aaPanel: a página default será gravada em $root"
    else
      need_apache; return 1
    fi
  fi
  if [[ $mode != auto ]]; then
    title "Página default do servidor"
    echo "  (1) Página HTML personalizada"
    [[ $apache == 1 ]] && echo "  (2) Redirecionar para uma URL" && echo "  (3) Bloquear (403) acessos por IP / domínio desconhecido"
    kind=$(ask "Tipo" 1)
  fi
  case $kind in
    1) if [[ $mode == auto ]]; then t=$(hostname); msg="Servidor online"
       else t=$(ask "Título" "$(hostname)"); msg=$(ask "Mensagem" "Servidor online"); fi
       mkdir -p "$root"; write_default_html "$root/index.html" "$t" "$msg"
       [[ $apache == 1 ]] && write_default_vhost html;;
    2) [[ $apache == 1 ]] || return 1
       url=$(ask "URL de destino (https://...)")
       [[ $url =~ ^https?:// ]] || { err "URL inválida"; return 1; }
       mkdir -p "$root"; write_default_vhost redirect "$url";;
    3) [[ $apache == 1 ]] || return 1
       mkdir -p "$root"; write_default_vhost deny;;
    *) err "Tipo inválido"; return 1;;
  esac
  if [[ $apache == 1 ]]; then
    a2ensite 000-default >/dev/null 2>&1
    apache_reload || return 1
  fi
  ok "Página default configurada (acesso pelo IP do servidor)"
}

# --------------------------------------------------------------------- Sites
write_site_index() {
  cat > "$1" <<EOF
<!doctype html>
<html lang="pt-br"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>$2</title>
<style>body{font-family:system-ui,sans-serif;background:#0f172a;color:#e2e8f0;display:flex;min-height:100vh;align-items:center;justify-content:center;margin:0}div{text-align:center}small{color:#64748b}</style>
</head><body><div><h1>$2</h1><p>Site no ar.</p><small>PHP <?= PHP_VERSION ?></small></div></body></html>
EOF
}

site_add() {
  need_apache || return 1
  title "Criar site"
  local d="${1:-}" alias="" t root docroot pv port body
  [[ -z $d ]] && d=$(ask "Domínio (ex: meusite.com)")
  d="${d,,}"; d="${d#http://}"; d="${d#https://}"; d="${d%%/*}"; d="${d#www.}"
  [[ $d =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$ ]] || { err "Domínio inválido: $d"; return 1; }
  [[ -f $APACHE_AV/$d.conf ]] && { err "O site $d já existe"; return 1; }
  confirm_yes "Responder também em www.$d?" && alias="www.$d"
  echo "Tipo de site:"
  echo "  (1) PHP / HTML (pasta public_html)"
  echo "  (2) Laravel (pasta public/)"
  echo "  (3) Proxy reverso para app Node / PM2 (porta local)"
  t=$(ask "Tipo" 1)
  root="$WWW/$d"
  case $t in
    1|2)
      pv=$(pick_php) || return 1
      if [[ $t == 1 ]]; then
        docroot="$root/public_html"; mkdir -p "$docroot"
        [[ -e $docroot/index.php || -e $docroot/index.html ]] || write_site_index "$docroot/index.php" "$d"
      else
        docroot="$root/public"; mkdir -p "$root"
      fi
      body=$(cat <<EOF
    DocumentRoot $docroot
    <Directory $docroot>
        Options -Indexes +FollowSymLinks
        AllowOverride All
        Require all granted
    </Directory>
    <FilesMatch "\.php$">
        SetHandler "proxy:unix:/run/php/php$pv-fpm.sock|fcgi://localhost"
    </FilesMatch>
EOF
);;
    3)
      port=$(ask "Porta local do app (ex: 3000)")
      [[ $port =~ ^[0-9]+$ ]] || { err "Porta inválida"; return 1; }
      a2enmod proxy proxy_http proxy_wstunnel rewrite headers >/dev/null
      docroot="$root"; mkdir -p "$root"
      body=$(cat <<EOF
    ProxyPreserveHost On
    ProxyPass / http://127.0.0.1:$port/
    ProxyPassReverse / http://127.0.0.1:$port/
    RewriteEngine On
    RewriteCond %{HTTP:Upgrade} =websocket [NC]
    RewriteRule /(.*) ws://127.0.0.1:$port/\$1 [P,L]
EOF
);;
    *) err "Tipo inválido"; return 1;;
  esac
  {
    echo "# Site $d - gerado por LK em $(date '+%F %T')"
    echo "<VirtualHost *:80>"
    echo "    ServerName $d"
    [[ -n $alias ]] && echo "    ServerAlias $alias"
    echo "$body"
    echo "    ErrorLog \${APACHE_LOG_DIR}/${d}_error.log"
    echo "    CustomLog \${APACHE_LOG_DIR}/${d}_access.log combined"
    echo "</VirtualHost>"
  } > "$APACHE_AV/$d.conf"
  chown -R www-data:www-data "$root"
  a2ensite "$d" >/dev/null
  if ! apache_reload; then a2dissite "$d" >/dev/null 2>&1; err "Site não ativado"; return 1; fi
  ok "Site http://$d criado -> $docroot"
  [[ $t == 2 ]] && info "Coloque o projeto Laravel em $root (ex: git clone ... $root) e rode a opção 29 (permissões)."
  if [[ $t != 3 ]] && has mysql && confirm "Criar banco de dados para este site?"; then db_create "${d//[^a-z0-9]/_}"; fi
  confirm "Emitir SSL agora? (o DNS do domínio já precisa apontar para este servidor)" && ssl_issue "$d"
}

site_list() {
  need_apache || return 1
  title "Sites"
  local f name en ssl path c1 c2 n=0
  printf "  %-32s %-4s %-4s %s\n" "DOMÍNIO" "ON" "SSL" "PASTA / DESTINO"
  for f in "$APACHE_AV"/*.conf; do
    [[ -f $f ]] || continue
    name=$(basename "$f" .conf)
    [[ $name == 000-default || $name == default-ssl || $name == *-le-ssl || $name == lkmonitor ]] && continue
    en="não"; c1=$R; [[ -e $APACHE_EN/$name.conf ]] && { en="sim"; c1=$G; }
    ssl="-";  c2=$D; [[ -f $APACHE_AV/$name-le-ssl.conf ]] && { ssl="sim"; c2=$G; }
    path=$(awk 'tolower($1)=="proxypass"{print $3; exit}' "$f")
    [[ -z $path ]] && path=$(awk 'tolower($1)=="documentroot"{print $2; exit}' "$f")
    site_root_missing "$name" && path="$path ${Y}⚠ pasta não existe${N}"
    printf "  %-32s %s%-4s%s %s%-4s%s %s\n" "$name" "$c1" "$en" "$N" "$c2" "$ssl" "$N" "$path"
    ((n++))
  done
  ((n)) || info "Nenhum site criado ainda"
}

site_del() {
  need_apache || return 1
  local d="${1:-}" c
  [[ -z $d ]] && { site_list; d=$(ask "Domínio para remover"); }
  [[ -n $d && -f $APACHE_AV/$d.conf ]] || { err "Site não encontrado: $d"; return 1; }
  confirm "Remover o site $d do Apache?" || return 1
  a2dissite "$d" >/dev/null 2>&1
  [[ -f $APACHE_AV/$d-le-ssl.conf ]] && a2dissite "$d-le-ssl" >/dev/null 2>&1
  if has certbot && certbot certificates 2>/dev/null | grep -q "Certificate Name: $d\$"; then
    certbot delete --cert-name "$d" --non-interactive >/dev/null 2>&1 && info "Certificado SSL removido"
  fi
  rm -f "$APACHE_AV/$d.conf" "$APACHE_AV/$d-le-ssl.conf"
  apache_reload
  if [[ -d $WWW/$d ]]; then
    c=$(ask "Apagar também os arquivos em $WWW/$d? Digite o domínio para confirmar (vazio = manter)" "")
    if [[ $c == "$d" ]]; then rm -rf "${WWW:?}/${d:?}"; ok "Arquivos apagados"; else info "Arquivos mantidos em $WWW/$d"; fi
  fi
  ok "Site $d removido"
}

site_is_on() { [[ -e $APACHE_EN/$1.conf ]]; }
# pasta do site (DocumentRoot); vazio para sites que são proxy (Node, apps)
site_root() { awk 'tolower($1)=="documentroot"{gsub(/"/, "", $2); print $2; exit}' "$APACHE_AV/$1.conf" 2>/dev/null; }
site_root_missing() { local r; r=$(site_root "$1"); [[ -n $r ]] && ! grep -qiE '^\s*proxypass\s' "$APACHE_AV/$1.conf" && [[ ! -d $r ]]; }

site_pick() { # escolhe um site pelo número ou nome
  local list=() f n i o
  for f in "$APACHE_AV"/*.conf; do
    [[ -f $f ]] || continue
    n=$(basename "$f" .conf)
    [[ $n == 000-default || $n == default-ssl || $n == *-le-ssl || $n == lkmonitor ]] && continue
    list+=("$n")
  done
  ((${#list[@]})) || { warn "Nenhum site criado ainda (use a opção 23)"; return 1; }
  for i in "${!list[@]}"; do
    local miss=""; site_root_missing "${list[i]}" && miss="  ${Y}⚠ a pasta $(site_root "${list[i]}") não existe${N}"
    if site_is_on "${list[i]}"; then printf "  (%d) %-32s %s● ligado%s%s\n" $((i+1)) "${list[i]}" "$G" "$N" "$miss" >&2
    else printf "  (%d) %-32s %s○ desligado%s%s\n" $((i+1)) "${list[i]}" "$R" "$N" "$miss" >&2; fi
  done
  o=$(ask "Site (número ou nome)")
  if [[ $o =~ ^[0-9]+$ ]] && ((o >= 1 && o <= ${#list[@]})); then echo "${list[o-1]}"; return 0; fi
  [[ -n $o && -f $APACHE_AV/$o.conf ]] && { echo "$o"; return 0; }
  err "Site inválido: $o"; return 1
}

site_enable() {
  need_apache || return 1
  local d="${1:-}"
  [[ -n $d && -f $APACHE_AV/$d.conf ]] || { err "Site não encontrado: $d"; return 1; }
  site_is_on "$d" && { info "$d já está ligado"; return 0; }
  if site_root_missing "$d"; then
    warn "A pasta do site não existe: $(site_root "$d")"
    warn "Ligado assim, $d vai responder com erro 404 (página não encontrada)."
    [[ -n ${LK_CLI:-} ]] && return 1
    confirm "Ligar mesmo assim?" || return 1
  fi
  a2ensite "$d" >/dev/null 2>&1
  [[ -f $APACHE_AV/$d-le-ssl.conf ]] && a2ensite "$d-le-ssl" >/dev/null 2>&1
  if apache_reload; then ok "Site $d ligado"; else a2dissite "$d" >/dev/null 2>&1; err "Não foi possível ligar $d"; return 1; fi
}

site_disable() {
  need_apache || return 1
  local d="${1:-}"
  [[ -n $d && -f $APACHE_AV/$d.conf ]] || { err "Site não encontrado: $d"; return 1; }
  site_is_on "$d" || { info "$d já está desligado"; return 0; }
  a2dissite "$d" >/dev/null 2>&1
  [[ -f $APACHE_AV/$d-le-ssl.conf ]] && a2dissite "$d-le-ssl" >/dev/null 2>&1
  apache_reload && ok "Site $d desligado (os arquivos continuam em $WWW/$d)"
}

site_toggle() {
  need_apache || return 1
  title "Ligar / desligar site"
  local d; d=$(site_pick) || return 1
  if site_is_on "$d"; then
    confirm "Desligar $d?" && site_disable "$d"
  else
    site_enable "$d"
  fi
}

ssl_issue() {
  need_apache || return 1
  local d="${1:-}" email doms
  [[ -z $d ]] && { site_list; d=$(ask "Domínio"); }
  [[ -f $APACHE_AV/$d.conf ]] || { err "Site $d não existe (crie na opção 23)"; return 1; }
  if ! has certbot; then info "Instalando certbot..."; apt_i certbot python3-certbot-apache >/dev/null || { err "Falha ao instalar certbot"; return 1; }; fi
  doms=(-d "$d")
  grep -qiE "ServerAlias.*www\.$d" "$APACHE_AV/$d.conf" && doms+=(-d "www.$d")
  email=$(ask "E-mail para o Let's Encrypt" "admin@$d")
  certbot --apache "${doms[@]}" --non-interactive --agree-tos -m "$email" --redirect \
    && ok "SSL ativo para $d (renovação automática pelo certbot)" \
    || err "Falha ao emitir SSL. Confira se o DNS de $d aponta para este servidor e se a porta 80 está aberta."
}

ssl_menu() {
  title "SSL grátis (Let's Encrypt)"
  echo "  (1) Emitir SSL para um site  (2) Listar certificados  (3) Testar renovação automática"
  case $(ask "Opção" 1) in
    1) ssl_issue;;
    2) has certbot && certbot certificates || warn "Certbot ainda não instalado";;
    3) has certbot && certbot renew --dry-run || warn "Certbot ainda não instalado";;
  esac
}

fix_perms() {
  title "Corrigir permissões"
  local p rp owner
  p=$(ask "Pasta do site" "$WWW/"); p="${p%/}"
  [[ -d $p ]] || { err "Pasta não existe"; return 1; }
  rp=$(realpath "$p")
  case "$rp" in /|/etc|/etc/*|/usr|/usr/*|/bin*|/sbin*|/boot*|/root|/var|/var/www|/home) err "Pasta protegida: $rp"; return 1;; esac
  owner=$(ask "Dono" "www-data")
  id "$owner" >/dev/null 2>&1 || { err "Usuário $owner não existe"; return 1; }
  chown -R "$owner:$owner" "$rp"
  find "$rp" -type d -not -path '*/node_modules/*' -exec chmod 755 {} +
  find "$rp" -type f -not -path '*/node_modules/*' -not -path '*/vendor/bin/*' -exec chmod 644 {} +
  if [[ -f $rp/artisan ]]; then
    chmod -R ug+rwx "$rp/storage" "$rp/bootstrap/cache" 2>/dev/null
    info "Laravel: storage/ e bootstrap/cache/ com permissão de escrita"
  fi
  ok "Permissões corrigidas em $rp"
}

# --------------------------------------------------------------------- Banco de dados
mysql_auth() {
  [[ -n ${MYSQL_ROOT_OK:-} ]] && return 0
  has mysql || { err "MySQL/MariaDB não instalado"; return 1; }
  if mysql -uroot -e "SELECT 1" >/dev/null 2>&1; then MYSQL_ROOT_OK=1; return 0; fi
  local pw; read -rsp "Senha root do MySQL: " pw; echo >&2
  if MYSQL_PWD="$pw" mysql -uroot -e "SELECT 1" >/dev/null 2>&1; then export MYSQL_PWD="$pw"; MYSQL_ROOT_OK=1; return 0; fi
  err "Senha root incorreta"; return 1
}
mysql_q() { mysql_auth || return 1; mysql -uroot "$@"; }

db_list() {
  title "Bancos de dados"
  mysql_q -N -e "SHOW DATABASES" | grep -vxE 'information_schema|performance_schema|mysql|sys' | sed 's/^/  - /'
}

db_create() {
  mysql_auth || return 1
  title "Criar banco de dados"
  local db u p
  db=$(ask "Nome do banco" "${1:-}")
  [[ $db =~ ^[A-Za-z0-9_]{1,64}$ ]] || { err "Nome inválido (use letras, números e _)"; return 1; }
  u=$(ask "Usuário" "${db:0:32}")
  [[ $u =~ ^[A-Za-z0-9_]{1,32}$ ]] || { err "Usuário inválido"; return 1; }
  p=$(ask "Senha (vazio = gerar automaticamente)" "")
  [[ -z $p ]] && p=$(gen_pass)
  [[ $p == *"'"* || $p == *\\* ]] && { err "A senha não pode ter aspas simples ou barra invertida"; return 1; }
  mysql_q -e "CREATE DATABASE IF NOT EXISTS \`$db\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
              CREATE USER IF NOT EXISTS '$u'@'localhost' IDENTIFIED BY '$p';
              ALTER USER '$u'@'localhost' IDENTIFIED BY '$p';
              GRANT ALL PRIVILEGES ON \`$db\`.* TO '$u'@'localhost';
              FLUSH PRIVILEGES;" || { err "Falha ao criar banco"; return 1; }
  echo "$(date '+%F %T') | db=$db | user=$u | pass=$p | host=localhost" >> "$LK_DBFILE"
  chmod 600 "$LK_DBFILE"
  ok "Banco criado"
  echo "  ${W}Banco:${N}   $db"
  echo "  ${W}Usuário:${N} $u"
  echo "  ${W}Senha:${N}   $p"
  echo "  ${D}.env Laravel -> DB_DATABASE=$db  DB_USERNAME=$u  DB_PASSWORD=$p${N}"
  echo "  ${D}Credenciais salvas em $LK_DBFILE${N}"
}

db_drop() {
  mysql_auth || return 1
  local db="${1:-}" c u f
  db_list
  [[ -z $db ]] && db=$(ask "Banco para remover")
  [[ $db =~ ^[A-Za-z0-9_]{1,64}$ ]] || { err "Nome inválido"; return 1; }
  case $db in mysql|information_schema|performance_schema|sys) err "Banco do sistema não pode ser removido"; return 1;; esac
  c=$(ask "Digite '$db' novamente para confirmar")
  [[ $c == "$db" ]] || { info "Cancelado"; return 1; }
  if confirm_yes "Fazer backup antes (.sql.gz)?"; then
    mkdir -p "$LK_BACKUPS"; f="$LK_BACKUPS/${db}_$(date +%Y%m%d_%H%M%S).sql.gz"
    mysqldump -uroot --single-transaction --routines "$db" | gzip > "$f" && info "Backup: $f"
  fi
  mysql_q -e "DROP DATABASE \`$db\`;" && ok "Banco $db removido"
  u=$(ask "Remover também o usuário (vazio = não)" "")
  [[ -n $u && $u =~ ^[A-Za-z0-9_]+$ ]] && mysql_q -e "DROP USER IF EXISTS '$u'@'localhost';" && ok "Usuário $u removido"
}

# --------------------------------------------------------------------- Info / logs / manutenção
server_info() {
  title "Informações do servidor"
  local pub
  pub=$(curl -s4 --max-time 4 https://ifconfig.me 2>/dev/null)
  printf "  %-14s %s\n" \
    "Hostname"   "$(hostname)" \
    "Sistema"    "$OS_NAME" \
    "Kernel"     "$(uname -r)" \
    "Uptime"     "$(uptime -p 2>/dev/null)" \
    "CPU"        "$(nproc) núcleo(s) - $(awk -F: '/model name/{gsub(/^ +/,"",$2); print $2; exit}' /proc/cpuinfo)" \
    "Load"       "$(cut -d' ' -f1-3 /proc/loadavg)" \
    "RAM"        "$(free -h | awk '/^Mem:/{print $3" usados de "$2}')" \
    "Swap"       "$(free -h | awk '/^Swap:/{print $3" usados de "$2}')" \
    "Disco /"    "$(df -h / | awk 'NR==2{print $3" usados de "$2" ("$5")"}')" \
    "IP público" "${pub:-?}" \
    "IPs locais" "$(hostname -I 2>/dev/null)"
  echo; echo "  ${W}Software${N}"
  has apache2  && printf "  %-14s %s\n" "Apache"   "$(apache2 -v 2>/dev/null | awk -F'[/ ]' '/version/{print $4}')"
  has php      && printf "  %-14s %s\n" "PHP (cli)" "$(php_default)"
  [[ -n $(php_versions) ]] && printf "  %-14s %s\n" "PHP instalados" "$(php_versions | tr '\n' ' ')"
  has mysql    && printf "  %-14s %s\n" "MySQL/MariaDB" "$(mysql -V 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+(-MariaDB)?' | head -n1)"
  has node     && printf "  %-14s %s\n" "Node.js"  "$(node -v)"
  has pm2      && printf "  %-14s %s\n" "PM2"      "$(pm2 -v 2>/dev/null)"
  has composer && printf "  %-14s %s\n" "Composer" "$(COMPOSER_ALLOW_SUPERUSER=1 composer --version 2>/dev/null | awk '{print $3}')"
  has supervisorctl && printf "  %-14s %s\n" "Supervisor" "$(supervisorctl version 2>/dev/null)"
  is_aapanel   && printf "  %-14s %s\n" "aaPanel" "sim (/www/server/panel)"
  printf "  %-14s %s\n" "LK" "v$LK_VERSION"
}

view_log() { # view_log arquivo
  local f="$1" m
  [[ -f $f ]] || { err "Log não encontrado: $f"; return 1; }
  m=$(ask "(1) Últimas 100 linhas  (2) Tempo real" 1)
  if [[ $m == 2 ]]; then follow tail -n 50 -f "$f"; else tail -n 100 "$f"; fi
}
view_journal() { # view_journal args...
  local m; m=$(ask "(1) Últimas 100 linhas  (2) Tempo real" 1)
  if [[ $m == 2 ]]; then follow journalctl -n 50 -f "$@"; else journalctl -n 100 --no-pager "$@"; fi
}

logs_menu() {
  title "Logs"
  echo "  (1) Apache - erros        (2) Apache - acessos      (3) Log de um site"
  echo "  (4) MariaDB/MySQL         (5) PHP-FPM               (6) Sistema (journal)"
  echo "  (7) Worker do Supervisor  (8) Auth / SSH            (9) Log do LK"
  local o d f s
  o=$(ask "Opção")
  case $o in
    1) view_log /var/log/apache2/error.log;;
    2) view_log /var/log/apache2/access.log;;
    3) d=$(ask "Domínio"); s=$(ask "(e) erros  (a) acessos" e)
       if [[ $s == a ]]; then view_log "/var/log/apache2/${d}_access.log"; else view_log "/var/log/apache2/${d}_error.log"; fi;;
    4) if [[ -f /var/log/mysql/error.log ]]; then view_log /var/log/mysql/error.log
       else s=$(db_svc) && view_journal -u "$s"; fi;;
    5) f=$(ls /var/log/php*-fpm.log 2>/dev/null | tail -n1)
       if [[ -n $f ]]; then view_log "$f"; else s=$(fpm_services | head -n1); [[ -n $s ]] && view_journal -u "$s"; fi;;
    6) view_journal;;
    7) d=$(ask "Nome do worker"); view_log "/var/log/supervisor/$d.log";;
    8) if [[ -f /var/log/auth.log ]]; then view_log /var/log/auth.log; else view_journal -u ssh -u sshd; fi;;
    9) view_log "$LK_LOG";;
  esac
}

sys_update() {
  title "Atualizar sistema / limpar disco"
  echo "  (1) Atualizar pacotes   (2) Limpar disco   (3) Ambos"
  local o before after
  o=$(ask "Opção" 3)
  if [[ $o == 1 || $o == 3 ]]; then
    info "Atualizando..."
    apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get -y -o Dpkg::Options::=--force-confold upgrade \
      && ok "Sistema atualizado"
  fi
  if [[ $o == 2 || $o == 3 ]]; then
    before=$(df --output=used -k / | tail -n1)
    apt-get -y autoremove >/dev/null 2>&1; apt-get -y autoclean >/dev/null 2>&1; apt-get clean
    journalctl --vacuum-time=7d >/dev/null 2>&1
    find /var/log -type f \( -name "*.gz" -o -regex '.*\.[0-9]+$' \) -mtime +14 -delete 2>/dev/null
    after=$(df --output=used -k / | tail -n1)
    ok "Espaço liberado: $(( (before - after) / 1024 )) MB"
  fi
  [[ -f /var/run/reboot-required ]] && warn "O sistema pede reinicialização (reboot)."
}

# --------------------------------------------------------------------- LK Monitor (painel web)
lkm_port() { [[ -f $LKM_SITE ]] && grep -m1 -oE '^Listen [0-9]+' "$LKM_SITE" | awk '{print $2}'; }
LKM_JOB="/usr/local/lib/lkmonitor/job.php"
lkm_php() { local p; p=$(grep -oP "define\('LKM_PHP_CLI', '\K[^']*" /var/www/lkmonitor/config.php 2>/dev/null); [[ -n $p && -x $p ]] && echo "$p" || command -v php; }
lkm_job() { # backups usam o executor de tarefas do LK Monitor
  [[ -f $LKM_JOB ]] || { err "Backups precisam do LK Monitor instalado (sudo lk -> opção 33)."; return 1; }
  "$(lkm_php)" -d memory_limit=512M "$LKM_JOB" "$@"
}
lkm_https_port() { [[ -f $LKM_SITE ]] && grep -m1 -oE '^Listen [0-9]+ https' "$LKM_SITE" | awk '{print $2}'; }

lkm_urls() {
  local port sport ip; port=$(lkm_port); sport=$(lkm_https_port)
  [[ -n $port ]] || return 1
  echo "  http://localhost:$port"
  for ip in $(hostname -I 2>/dev/null); do
    [[ $ip == *:* || $ip == 172.17.* || $ip == 192.168.122.* ]] && continue
    echo "  http://$ip:$port"
    [[ -n $sport ]] && echo "  https://$ip:$sport  ${D}(app no celular)${N}"
  done
  return 0
}

lkm_run() {
  [[ -f $LKM_INSTALLER ]] || { err "Instalador do LK Monitor não encontrado em $LKM_INSTALLER. Rode o install-lk.sh mais recente."; return 1; }
  bash "$LKM_INSTALLER" "$@"
}

monitor_menu() {
  title "LK Monitor (painel web: uso, histórico, sites, arquivos e terminal completo)"
  local port; port=$(lkm_port)
  if [[ -n $port ]]; then
    echo "  Status: ${G}instalado${N} na porta $port$([[ -n $(lkm_https_port) ]] && echo " (HTTPS na $(lkm_https_port))")"
    if systemctl is-active --quiet lkmonitor-collect.timer 2>/dev/null; then echo "  Histórico: ${G}coletando${N} a cada minuto (7 dias)"
    else echo "  Histórico: ${Y}parado${N} (use a opção 1 para atualizar)"; fi
    if systemctl is-active --quiet lkmonitor-term 2>/dev/null; then echo "  Terminal:  ${G}completo${N} (nano, htop, o menu do lk...)"
    elif [[ -f /etc/systemd/system/lkmonitor-term.service ]]; then echo "  Terminal:  ${Y}serviço parado${N} (opção 4 reinicia; log: journalctl -u lkmonitor-term)"
    else echo "  Terminal:  simples (use a opção 1 para atualizar e ter o terminal completo)"; fi
    lkm_urls
  else
    echo "  Status: ${Y}não instalado${N}"
  fi
  echo
  echo "  (1) Instalar / atualizar        (2) Mostrar endereços"
  echo "  (3) Trocar senha do painel      (4) Reiniciar painel"
  echo "  (5) Histórico de ações          (6) Remover painel"
  local o; o=$(ask "Opção" "$([[ -n $port ]] && echo 2 || echo 1)")
  case $o in
    1) lkm_run;;
    2) lkm_urls || warn "Painel não instalado (use a opção 1)";;
    3) [[ -n $port ]] || { warn "Painel não instalado"; return 1; }; lkm_run senha;;
    4) [[ -n $port ]] || { warn "Painel não instalado"; return 1; }
       local s; for s in $(fpm_services); do systemctl restart "$s"; done
       systemctl restart lkmonitor-collect.timer 2>/dev/null
       apache_reload && ok "Painel reiniciado"
       if [[ -f /etc/systemd/system/lkmonitor-term.service ]]; then
         if grep -q 'lkmonitor-term' /proc/$$/cgroup 2>/dev/null; then
           warn "Você está no terminal do painel: ele reinicia em 5 s e reconecta sozinho."
           systemd-run --quiet --on-active=5 /bin/systemctl restart lkmonitor-term.service >/dev/null 2>&1
         else
           systemctl restart lkmonitor-term.service && ok "Terminal do painel reiniciado"
         fi
       fi;;
    5) if [[ -f /var/lib/lkmonitor/cmd.log ]]; then tail -n 40 /var/lib/lkmonitor/cmd.log; else info "Nenhuma ação registrada"; fi;;
    6) [[ -n $port ]] || { warn "Painel não instalado"; return 1; }
       confirm "Remover o LK Monitor?" && lkm_run uninstall;;
    *) return 0;;
  esac
}

# --------------------------------------------------------------------- SSH
SSH_DROP="/etc/ssh/sshd_config.d"

ssh_installed() { svc_has ssh || svc_has sshd; }
ssh_svc() { svc_has ssh && echo ssh || echo sshd; }
ssh_root_mode() { sshd -T 2>/dev/null | awk '/^permitrootlogin /{print $2; exit}'; }

ssh_apply() { # valida e reinicia
  local out
  if ! out=$(sshd -t 2>&1); then err "Configuração do SSH inválida, nada foi aplicado:"; echo "$out"; return 1; fi
  systemctl daemon-reload
  systemctl is-enabled ssh.socket >/dev/null 2>&1 && systemctl restart ssh.socket
  systemctl restart "$(ssh_svc)" && ok "SSH reiniciado"
}

ssh_status() {
  if ! ssh_installed; then echo "  Status: ${Y}servidor SSH não instalado${N}"; return 1; fi
  local st port root ip
  st=$(systemctl is-active "$(ssh_svc)" 2>/dev/null)
  systemctl is-active ssh.socket >/dev/null 2>&1 && st="active (socket)"
  port=$(ssh_port); root=$(ssh_root_mode)
  echo "  Status:      $([[ $st == active* ]] && echo "${G}$st${N}" || echo "${R}${st:-parado}${N}")"
  echo "  Porta:       $port"
  case $root in
    yes) echo "  Login root:  ${Y}permitido com senha${N}";;
    prohibit-password|without-password) echo "  Login root:  só com chave SSH";;
    no) echo "  Login root:  bloqueado";;
    *) echo "  Login root:  ${root:-?}";;
  esac
  echo "  Conectar:"
  for ip in $(hostname -I 2>/dev/null); do
    [[ $ip == *:* || $ip == 172.17.* || $ip == 192.168.122.* ]] && continue
    if [[ $port == 22 ]]; then echo "    ssh root@$ip"; else echo "    ssh -p $port root@$ip"; fi
  done
}

ssh_menu() {
  title "SSH (acesso remoto pelo terminal)"
  ssh_status; echo
  echo "  (1) Instalar / ativar SSH          (2) Permitir login root com senha"
  echo "  (3) Bloquear login root            (4) Trocar porta do SSH"
  echo "  (5) Reiniciar SSH                  (6) Quem está conectado"
  echo "  (7) Desativar SSH"
  local o p me; o=$(ask "Opção" "$(ssh_installed && echo 6 || echo 1)")
  me=$(awk '{print $1}' <<< "${SSH_CLIENT:-}")
  case $o in
    1) if ! ssh_installed; then info "Instalando openssh-server..."; apt_i openssh-server >/dev/null || { err "Falha ao instalar"; return 1; }; fi
       systemctl enable --now "$(ssh_svc)" >/dev/null 2>&1
       if has ufw && ufw status 2>/dev/null | grep -q "Status: active"; then ufw allow "$(ssh_port)/tcp" >/dev/null; fi
       ok "SSH ativo"; ssh_status;;
    2) ssh_installed || { err "Instale o SSH primeiro (opção 1)"; return 1; }
       if ! grep -q '^root:[$]' /etc/shadow 2>/dev/null; then
         warn "O root ainda não tem senha. Crie agora:"
         passwd root || return 1
       fi
       mkdir -p "$SSH_DROP"; echo "PermitRootLogin yes" > "$SSH_DROP/10-root.conf"
       ssh_apply && ok "Login root com senha permitido";;
    3) ssh_installed || { err "Instale o SSH primeiro (opção 1)"; return 1; }
       [[ -n $me ]] && [[ $(id -u) -eq 0 && -z ${SUDO_USER:-} ]] && warn "Você está conectado como root por SSH. A sessão atual continua, mas novas conexões como root serão recusadas."
       confirm "Bloquear login do root pelo SSH?" || return 0
       mkdir -p "$SSH_DROP"; echo "PermitRootLogin no" > "$SSH_DROP/10-root.conf"
       ssh_apply && ok "Login root bloqueado (entre com seu usuário e use sudo)";;
    4) ssh_installed || { err "Instale o SSH primeiro (opção 1)"; return 1; }
       p=$(ask "Nova porta (1024-65535, ou 22)" "$(ssh_port)")
       [[ $p =~ ^[0-9]+$ ]] && { ((p == 22)) || ((p >= 1024 && p <= 65535)); } || { err "Porta inválida"; return 1; }
       if [[ $p != "$(ssh_port)" ]] && ss -ltnH "sport = :$p" 2>/dev/null | grep -q .; then err "A porta $p já está em uso"; return 1; fi
       if has ufw && ufw status 2>/dev/null | grep -q "Status: active"; then ufw allow "$p/tcp" >/dev/null && info "Porta $p liberada no UFW"; fi
       mkdir -p "$SSH_DROP"; echo "Port $p" > "$SSH_DROP/20-lk-port.conf"
       ssh_apply && ok "SSH agora na porta $p. Conecte com: ssh -p $p usuario@IP"
       [[ -n $me ]] && warn "Teste a nova porta em outra janela antes de fechar esta.";;
    5) ssh_installed && ssh_apply;;
    6) who; echo; ss -tnp state established "( sport = :$(ssh_port) )" 2>/dev/null | tail -n +2 | awk '{print "  conexão de " $4}';;
    7) ssh_installed || return 0
       [[ -n $me ]] && warn "Você está conectado por SSH agora! Ao desativar, novas conexões não serão aceitas."
       confirm "Desativar o servidor SSH?" || return 0
       systemctl disable --now ssh.socket >/dev/null 2>&1
       systemctl disable --now "$(ssh_svc)" >/dev/null 2>&1 && ok "SSH desativado";;
    *) return 0;;
  esac
}

# --------------------------------------------------------------------- Modo servidor (tela / desktop)
GRUB_DEF="/etc/default/grub"
LID_CONF="/etc/systemd/logind.conf.d/lk-tampa.conf"
SLEEP_TARGETS="sleep.target suspend.target hibernate.target hybrid-sleep.target"

cpu_temp() {
  local t max=0 f
  for f in /sys/class/thermal/thermal_zone*/temp /sys/class/hwmon/hwmon*/temp*_input; do
    [[ -r $f ]] || continue
    t=$(<"$f"); [[ $t =~ ^[0-9]+$ ]] && ((t < 150000 && t > max)) && max=$t
  done
  ((max)) && echo "$((max / 1000)) °C" || echo "sem sensor"
}

grub_has()    { [[ -f $GRUB_DEF ]] && grep -q "^GRUB_CMDLINE_LINUX_DEFAULT=.*$1" "$GRUB_DEF"; }
grub_add() {
  [[ -f $GRUB_DEF ]] || { warn "$GRUB_DEF não encontrado"; return 1; }
  grub_has "$1" && return 0
  if grep -q '^GRUB_CMDLINE_LINUX_DEFAULT=' "$GRUB_DEF"; then
    sed -i "s/^GRUB_CMDLINE_LINUX_DEFAULT=\"/&$1 /" "$GRUB_DEF"
  else
    echo "GRUB_CMDLINE_LINUX_DEFAULT=\"$1\"" >> "$GRUB_DEF"
  fi
}
grub_del() { [[ -f $GRUB_DEF ]] && sed -i -E "/^GRUB_CMDLINE_LINUX_DEFAULT=/ s/ ?$1//g; /^GRUB_CMDLINE_LINUX_DEFAULT=/ s/=\" /=\"/" "$GRUB_DEF"; }
grub_update() {
  if has update-grub; then update-grub >/dev/null 2>&1 && return 0
  elif has grub-mkconfig; then grub-mkconfig -o /boot/grub/grub.cfg >/dev/null 2>&1 && return 0; fi
  warn "Não foi possível atualizar o GRUB (vale no próximo update-grub)"; return 1
}

screen_off() {
  local f n=0
  for f in /sys/class/graphics/fb*/blank; do [[ -w $f ]] && echo 1 > "$f" 2>/dev/null && ((n++)); done
  for f in /sys/class/backlight/*/bl_power; do [[ -w $f ]] && echo 4 > "$f" 2>/dev/null && ((n++)); done
  ((n)) && ok "Tela apagada (aperte uma tecla no notebook ou use 'lk tela on' para acender)" || warn "Não encontrei a tela para apagar"
}
screen_on() {
  local f
  for f in /sys/class/backlight/*/bl_power; do [[ -w $f ]] && echo 0 > "$f" 2>/dev/null; done
  for f in /sys/class/graphics/fb*/blank; do [[ -w $f ]] && echo 0 > "$f" 2>/dev/null; done
  ok "Tela acesa"
}

server_mode_status() {
  local def cur
  def=$(systemctl get-default 2>/dev/null)
  if systemctl is-active graphical.target >/dev/null 2>&1; then cur="área de trabalho ligada"; else cur="sem área de trabalho"; fi
  echo "  Modo:            $([[ $def == multi-user.target ]] && echo "${G}servidor${N}" || echo "${Y}normal (área de trabalho)${N}")  ·  agora: $cur"
  echo "  Apagar tela:     $(grub_has consoleblank= && echo "após 1 min sem uso" || { grub_has 'video=eDP-1:d' && echo "sempre desligada" || echo "não"; })"
  echo "  Suspender:       $(systemctl is-enabled suspend.target 2>/dev/null | grep -q masked && echo "bloqueado" || echo "permitido")"
  echo "  Fechar a tampa:  $([[ -f $LID_CONF || -f ${LID_CONF%/*}/tampa.conf ]] && echo "continua ligado" || echo "padrão do sistema (pode suspender)")"
  echo "  Temperatura:     $(cpu_temp)"
  has powerprofilesctl && echo "  Energia:         $(powerprofilesctl get 2>/dev/null)"
}

server_mode_on() {
  title "Ativando modo servidor"
  systemctl set-default multi-user.target >/dev/null 2>&1 && ok "Área de trabalho desligada no boot"
  grub_del 'video=eDP-1:d'; grub_add consoleblank=60 && grub_update && ok "Tela apaga sozinha após 1 minuto"
  mkdir -p "$(dirname "$LID_CONF")"
  rm -f "${LID_CONF%/*}/tampa.conf"
  printf '[Login]\nHandleLidSwitch=ignore\nHandleLidSwitchExternalPower=ignore\nHandleLidSwitchDocked=ignore\n' > "$LID_CONF"
  ok "Fechar a tampa não suspende"
  systemctl mask $SLEEP_TARGETS >/dev/null 2>&1 && ok "Suspensão e hibernação bloqueadas"
  if ! has thermald; then info "Instalando thermald..."; apt_i thermald >/dev/null 2>&1; fi
  systemctl enable --now thermald >/dev/null 2>&1 && ok "Controle de temperatura (thermald) ativo"
  has powerprofilesctl && powerprofilesctl set power-saver 2>/dev/null && ok "Perfil de energia: economia"
  echo
  echo "  (1) Desligar a área de trabalho agora (sem reiniciar)"
  echo "  (2) Reiniciar agora"
  echo "  (3) Deixar para o próximo boot"
  case ${LK_SM_NOW:-$(ask "Opção" 1)} in
    1) info "Desligando a área de trabalho..."; systemctl isolate multi-user.target && ok "Modo servidor ativo";;
