#!/usr/bin/env bash
# =====================================================================
#  LK - Mini gestor de hosting via terminal (Ubuntu / Debian)
#  Uso:  lk          -> menu interativo
#        lk help     -> comandos diretos
# =====================================================================

LK_VERSION="2.3.0"
LKM_INSTALLER="/usr/local/share/lk/install-lk-monitor.sh"
LKM_SITE="/etc/apache2/sites-available/lkmonitor.conf"
LK_DIR="/etc/lk"
LK_BLOCKLIST="$LK_DIR/blocked_ips.txt"
LK_DBFILE="$LK_DIR/databases.txt"
LK_BACKUPS="/root/lk-backups"
LK_LOG="/var/log/lk.log"
WWW="/var/www"
APACHE_AV="/etc/apache2/sites-available"
APACHE_EN="/etc/apache2/sites-enabled"
DEFAULT_ROOT="/var/www/default"
LK_CLI=""

if [[ -t 1 ]]; then
  R=$'\e[31m'; G=$'\e[32m'; Y=$'\e[33m'; C=$'\e[36m'; W=$'\e[1m'; D=$'\e[2m'; N=$'\e[0m'
else
  R=""; G=""; Y=""; C=""; W=""; D=""; N=""
fi

# --------------------------------------------------------------------- utilidades
log()     { echo "$(date '+%F %T') $*" >> "$LK_LOG" 2>/dev/null || true; }
ok()      { echo "${G}[OK]${N} $*"; log "OK: $*"; }
err()     { echo "${R}[ERRO]${N} $*" >&2; log "ERRO: $*"; }
info()    { echo "${C}[..]${N} $*"; }
warn()    { echo "${Y}[!]${N} $*"; }
title()   { echo; echo "${W}${C}== $* ==${N}"; }
has()     { command -v "$1" >/dev/null 2>&1; }
svc_has() { systemctl cat "$1" >/dev/null 2>&1; }
is_aapanel() { [[ -d /www/server/panel ]]; }
apt_i()   { DEBIAN_FRONTEND=noninteractive apt-get install -y "$@"; }
pause()   { [[ -n "$LK_CLI" ]] && return 0; echo; read -rp "ENTER para voltar ao menu..." _ ; }
ask()     { local q="$1" def="${2:-}" a
            if [[ -n "$def" ]]; then read -rp "$q [$def]: " a; echo "${a:-$def}"
            else read -rp "$q: " a; echo "$a"; fi; }
confirm()     { local a; read -rp "$1 [s/N]: " a; [[ "$a" =~ ^[sSyY]$ ]]; }
confirm_yes() { local a; read -rp "$1 [S/n]: " a; [[ ! "$a" =~ ^[nN]$ ]]; }
gen_pass()    { tr -dc 'A-Za-z0-9' </dev/urandom 2>/dev/null | head -c 20; }
html_esc()    { sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' -e 's/"/\&quot;/g' <<< "$1"; }
follow()      { info "Ctrl+C para parar"; trap 'echo' INT; "$@"; trap - INT; }

load_os() {
  OS_ID=""; OS_NAME="Linux"
  if [[ -r /etc/os-release ]]; then
    OS_ID=$(. /etc/os-release; echo "${ID:-}")
    OS_NAME=$(. /etc/os-release; echo "${PRETTY_NAME:-Linux}")
  fi
}

php_versions() { ls /etc/php 2>/dev/null | grep -E '^[0-9]+\.[0-9]+$' | sort -V; }
php_default()  { has php && php -r 'echo PHP_MAJOR_VERSION.".".PHP_MINOR_VERSION;' 2>/dev/null; }
fpm_services() { systemctl list-unit-files --no-legend --type=service 'php*fpm*' 2>/dev/null | awk '{print $1}' | sed 's/\.service$//' | sort -u; }
apache_svc()   { local s; for s in apache2 httpd; do svc_has "$s" && { echo "$s"; return 0; }; done; return 1; }
db_svc()       { local s; for s in mariadb mysql mysqld; do svc_has "$s" && { echo "$s"; return 0; }; done; return 1; }

choose_from() { # choose_from "titulo" item1 item2 ... -> echo item escolhido (padrão = último)
  local t="$1"; shift; local items=("$@") i o
  ((${#items[@]})) || return 1
  if ((${#items[@]} == 1)); then echo "${items[0]}"; return 0; fi
  echo "$t" >&2
  for i in "${!items[@]}"; do echo "  ($((i+1))) ${items[i]}" >&2; done
  o=$(ask "Escolha" "${#items[@]}")
  if [[ $o =~ ^[0-9]+$ ]] && ((o >= 1 && o <= ${#items[@]})); then echo "${items[o-1]}"; else echo "${items[-1]}"; fi
}

pick_php() { # versão com FPM
  local vs=() v
  for v in $(php_versions); do [[ -d /etc/php/$v/fpm ]] && vs+=("$v"); done
  ((${#vs[@]})) || { err "Nenhum PHP-FPM instalado (use a opção 1)."; return 1; }
  choose_from "Versões do PHP-FPM:" "${vs[@]}"
}

pick_php_bin() {
  local bins=() b
  for b in /usr/bin/php[0-9]*.[0-9]*; do [[ -x $b ]] && bins+=("$b"); done
  if ((${#bins[@]} == 0)); then command -v php; return; fi
  choose_from "Binário do PHP:" "${bins[@]}"
}

need_apache() {
  [[ -d /etc/apache2 ]] && return 0
  if is_aapanel; then err "Este servidor usa o Apache do aaPanel. Gerencie os sites pelo painel."
  else err "Apache não instalado (use a opção 1)."; fi
  return 1
}

apache_test() {
  if has apache2ctl; then apache2ctl configtest
  elif [[ -x /www/server/apache/bin/apachectl ]]; then /www/server/apache/bin/apachectl -t
  else return 0; fi
}

apache_reload() {
  local out
  if ! out=$(apache_test 2>&1); then err "Configuração do Apache com erro:"; echo "$out"; return 1; fi
  systemctl reload "$(apache_svc)" && return 0
}

# --------------------------------------------------------------------- serviços
svc_restart() {
  local s
  for s in "$@"; do
    if svc_has "$s"; then
      info "Reiniciando $s..."
      if systemctl restart "$s"; then ok "$s reiniciado"
      else err "Falha ao reiniciar $s"; systemctl status "$s" --no-pager -l 2>/dev/null | tail -n 15; fi
    else warn "Serviço $s não encontrado"; fi
  done
}

restart_apache() {
  local s out
  s=$(apache_svc) || { warn "Apache não encontrado"; return 1; }
  if ! out=$(apache_test 2>&1); then err "Configuração com erro, restart cancelado:"; echo "$out"; return 1; fi
  svc_restart "$s"
}
restart_db()   { local s; s=$(db_svc) || { warn "MariaDB/MySQL não encontrado"; return 1; }; svc_restart "$s"; }
restart_php()  { local l; l=$(fpm_services); [[ -n $l ]] || { warn "Nenhum PHP-FPM encontrado"; return 1; }; svc_restart $l; }
restart_lamp() { restart_php; restart_db; restart_apache; }

known_services() {
  local s
  for s in apache2 httpd nginx; do svc_has "$s" && echo "$s"; done
  if svc_has mariadb; then echo mariadb; else for s in mysql mysqld; do svc_has "$s" && { echo "$s"; break; }; done; fi
  fpm_services
  for s in redis-server supervisor cron ssh fail2ban docker pm2-root; do svc_has "$s" && echo "$s"; done
}

svc_manage() {
  title "Gerenciar serviço"
  local list=() s i o a
  mapfile -t list < <(known_services)
  ((${#list[@]})) || { warn "Nenhum serviço conhecido encontrado"; return 1; }
  for i in "${!list[@]}"; do printf "  (%d) %-22s %s\n" $((i+1)) "${list[i]}" "$(systemctl is-active "${list[i]}" 2>/dev/null)"; done
  o=$(ask "Serviço (número ou nome)")
  if [[ $o =~ ^[0-9]+$ ]]; then ((o >= 1)) && s="${list[o-1]:-}"; else s="$o"; fi
  if [[ -z $s ]] || ! svc_has "$s"; then err "Serviço inválido"; return 1; fi
  echo "  (1) Iniciar  (2) Parar  (3) Reiniciar  (4) Recarregar  (5) Status  (6) Ativar no boot  (7) Desativar no boot"
  a=$(ask "Ação" 3)
  if [[ $s == ssh && $a =~ ^(2|7)$ ]]; then confirm "Parar o SSH pode te deixar sem acesso. Continuar?" || return 1; fi
  case $a in
    1) systemctl start "$s";;
    2) systemctl stop "$s";;
    3) systemctl restart "$s";;
    4) systemctl reload "$s";;
    5) systemctl status "$s" --no-pager -l | head -n 25; return 0;;
    6) systemctl enable "$s";;
    7) systemctl disable "$s";;
    *) err "Ação inválida"; return 1;;
  esac && ok "$s: $(systemctl is-active "$s" 2>/dev/null)"
}

show_status() {
  title "Status dos serviços"
  local s st
  for s in $(known_services); do
    st=$(systemctl is-active "$s" 2>/dev/null)
    if [[ $st == active ]]; then printf "  %-22s %s● ativo%s\n" "$s" "$G" "$N"
    else printf "  %-22s %s○ %s%s\n" "$s" "$R" "${st:-desconhecido}" "$N"; fi
  done
  has pm2 && echo "  PM2: $(pm2 jlist 2>/dev/null | grep -o '"pm_id"' | wc -l) app(s)"
  echo "  IPs bloqueados: $(blocked_count)"
}

# --------------------------------------------------------------------- LAMP
add_php_repo() {
  local code; code=$(. /etc/os-release; echo "${VERSION_CODENAME:-}")
  if [[ $OS_ID == ubuntu ]]; then
    apt_i software-properties-common >/dev/null && add-apt-repository -y ppa:ondrej/php >/dev/null || return 1
  elif [[ $OS_ID == debian ]]; then
    curl -fsSLo /tmp/debsuryorg-archive-keyring.deb https://packages.sury.org/debsuryorg-archive-keyring.deb \
      && dpkg -i /tmp/debsuryorg-archive-keyring.deb >/dev/null || return 1
    echo "deb [signed-by=/usr/share/keyrings/deb.sury.org-php.gpg] https://packages.sury.org/php/ $code main" > /etc/apt/sources.list.d/php.list
  else
    err "Repositório PHP extra só para Ubuntu/Debian"; return 1
  fi
  apt-get update -qq
}

install_lamp() {
  title "Instalar LAMP"
  has apt-get || { err "Apenas Ubuntu/Debian"; return 1; }
  if is_aapanel; then
    warn "aaPanel detectado: ele já gerencia Apache/MySQL/PHP (portas 80, 443, 3306)."
    warn "Instalar o LAMP do sistema junto causa conflito de portas."
    [[ ${LK_AUTO:-0} == 1 ]] && return 1
    confirm "Continuar mesmo assim?" || return 1
  fi
  local o=1 v="" p
  if [[ ${LK_AUTO:-0} != 1 ]]; then
    echo "Versão do PHP:"
    echo "  (1) Padrão do sistema   (2) 8.1   (3) 8.2   (4) 8.3   (5) 8.4"
    o=$(ask "Escolha" 1)
  fi
  case $o in 2) v=8.1;; 3) v=8.2;; 4) v=8.3;; 5) v=8.4;; esac
  info "Atualizando pacotes..."
  apt-get update -qq
  apt_i ca-certificates curl gnupg unzip >/dev/null
  if [[ -n $v ]]; then add_php_repo || { err "Falha ao adicionar repositório do PHP $v"; return 1; }; fi
  p="php${v}"
  info "Instalando Apache, MariaDB e PHP ${v:-padrão}..."
  apt_i apache2 mariadb-server mariadb-client \
    "$p-fpm" "$p-cli" "$p-common" "$p-mysql" "$p-curl" "$p-gd" "$p-mbstring" "$p-xml" \
    "$p-zip" "$p-bcmath" "$p-intl" "$p-readline" "$p-soap" "$p-sqlite3" \
    || { err "Falha na instalação dos pacotes"; return 1; }
  [[ -z $v ]] && v=$(php_default)

  a2dismod "php$v" >/dev/null 2>&1; a2dismod mpm_prefork >/dev/null 2>&1
  a2enmod mpm_event proxy_fcgi setenvif rewrite headers ssl expires >/dev/null
  a2enconf "php$v-fpm" >/dev/null
  echo "ServerName localhost" > /etc/apache2/conf-available/lk-servername.conf
  cat > /etc/apache2/conf-available/lk-security.conf <<'EOF'
ServerTokens Prod
ServerSignature Off
TraceEnable Off
EOF
  a2enconf lk-servername lk-security >/dev/null
  apache_proxy_https noreload
  cat > "/etc/php/$v/fpm/conf.d/99-lk.ini" <<'EOF'
upload_max_filesize = 64M
post_max_size = 64M
memory_limit = 256M
max_execution_time = 120
expose_php = Off
EOF
  systemctl enable --now "php$v-fpm" mariadb apache2 >/dev/null 2>&1
  systemctl restart "php$v-fpm" apache2
  mysql -uroot -e "DROP USER IF EXISTS ''@'localhost'; DROP USER IF EXISTS ''@'$(hostname)'; DROP DATABASE IF EXISTS test; FLUSH PRIVILEGES;" >/dev/null 2>&1
  if has ufw && ufw status 2>/dev/null | grep -q "Status: active"; then ufw allow 80,443/tcp >/dev/null; fi
  [[ -f $DEFAULT_ROOT/index.html ]] || create_default_page auto
  ok "LAMP instalado (Apache + MariaDB + PHP $v)"
  [[ ${LK_AUTO:-0} == 1 ]] && return 0
  has composer || { confirm_yes "Instalar o Composer também?" && install_composer; }
}

# Instalação completa sem perguntas: LAMP (se faltar) + painel com senha temporária (trocada no 1º login)
lk_setup() {
  title "LkPanel - instalação completa"
  has apt-get || { err "Apenas Ubuntu/Debian"; return 1; }
  if [[ -f /var/www/lkmonitor/config.php ]]; then
    ok "O painel já está instalado. Atualizando sem mudar porta, senha nem dados..."
    bash "$LKM_INSTALLER" atualizar; return
  fi
  if ! has apache2 || ! ls /etc/php/*/fpm/pool.d >/dev/null 2>&1; then
    info "Instalando Apache, PHP e MariaDB (pode levar alguns minutos)..."
    LK_AUTO=1 install_lamp || { err "Falha ao instalar o LAMP"; return 1; }
  fi
  [[ -f $LKM_INSTALLER ]] || { err "Instalador do painel não encontrado em $LKM_INSTALLER. Rode o install-lk.sh mais recente."; return 1; }
  if ! ssh_installed; then
    info "Instalando o SSH (o root liga no 1º acesso ao painel)..."
    apt_i openssh-server >/dev/null 2>&1 && systemctl enable --now "$(ssh_svc)" >/dev/null 2>&1 || warn "Não foi possível instalar o SSH agora (depois: sudo lk ssh)"
  fi
  has ufw && ufw status 2>/dev/null | grep -q "Status: active" && ufw allow "$(ssh_port)/tcp" >/dev/null 2>&1
  LKM_AUTO=1 bash "$LKM_INSTALLER" instalar
}

install_composer() {
  has php || { err "Instale o PHP primeiro (opção 1)"; return 1; }
  info "Instalando Composer..."
  curl -fsSL https://getcomposer.org/installer -o /tmp/composer-setup.php \
    && php /tmp/composer-setup.php --quiet --install-dir=/usr/local/bin --filename=composer \
    && rm -f /tmp/composer-setup.php \
    && ok "$(COMPOSER_ALLOW_SUPERUSER=1 composer --version 2>/dev/null | head -n1)"
}

# --------------------------------------------------------------------- Node / PM2
install_node() {
  local v; v=$(ask "Versão do Node.js (20, 22, 24)" 22)
  [[ $v =~ ^[0-9]+$ ]] || { err "Versão inválida"; return 1; }
  apt_i curl ca-certificates gnupg >/dev/null
  info "Instalando Node.js $v..."
  curl -fsSL "https://deb.nodesource.com/setup_${v}.x" | bash - >/dev/null && apt_i nodejs >/dev/null \
    && ok "Node.js $(node -v) instalado" || { err "Falha ao instalar Node.js"; return 1; }
}

install_pm2() {
  title "Node.js + PM2"
  if has node; then
    info "Node.js já instalado: $(node -v)"
    confirm "Trocar a versão do Node?" && { install_node || return 1; }
  else
    install_node || return 1
  fi
  info "Instalando PM2..."
  npm install -g pm2 >/dev/null 2>&1 || { err "Falha ao instalar PM2"; return 1; }
  pm2 startup systemd -u root --hp /root >/dev/null 2>&1
  pm2 save >/dev/null 2>&1
  ok "PM2 $(pm2 -v) instalado e configurado para iniciar no boot"
}

pm2_need() { has pm2 || { err "PM2 não instalado (opção 8)"; return 1; }; }

pm2_start() {
  pm2_need || return 1
  title "Iniciar app no PM2"
  echo "  (1) Arquivo JS (ex: /var/www/api/server.js)"
  echo "  (2) Projeto npm (npm run <script>)"
  echo "  (3) Comando livre"
  local t name port file dir script cmd envp=()
  t=$(ask "Tipo" 1)
  name=$(ask "Nome do app")
  [[ -n $name ]] || { err "Nome obrigatório"; return 1; }
  port=$(ask "Porta (variável PORT) - vazio para não definir" "")
  [[ -n $port ]] && envp=(env "PORT=$port")
  case $t in
    1) file=$(ask "Caminho do arquivo")
       [[ -f $file ]] || { err "Arquivo não encontrado"; return 1; }
       (cd "$(dirname "$file")" && "${envp[@]}" pm2 start "$file" --name "$name" --update-env);;
    2) dir=$(ask "Pasta do projeto")
       [[ -f $dir/package.json ]] || { err "package.json não encontrado em $dir"; return 1; }
       script=$(ask "Script do npm" start)
       (cd "$dir" && "${envp[@]}" pm2 start npm --name "$name" --update-env -- run "$script");;
    3) dir=$(ask "Pasta de trabalho" "$PWD")
       cmd=$(ask "Comando")
       [[ -n $cmd ]] || { err "Comando vazio"; return 1; }
       (cd "$dir" && "${envp[@]}" pm2 start bash --name "$name" --update-env -- -c "$cmd");;
    *) err "Tipo inválido"; return 1;;
  esac && pm2 save >/dev/null 2>&1 && ok "App '$name' iniciado e salvo no PM2"
}

pm2_manage() {
  pm2_need || return 1
  pm2 ls
  local id a
  id=$(ask "Nome ou ID do app (all = todos)")
  [[ -n $id ]] || return 0
  echo "  (1) Reiniciar  (2) Reload sem downtime  (3) Parar  (4) Iniciar  (5) Remover"
  a=$(ask "Ação" 1)
  case $a in
    1) pm2 restart "$id" --update-env;;
    2) pm2 reload "$id";;
    3) pm2 stop "$id";;
    4) pm2 start "$id";;
    5) confirm "Remover '$id' do PM2?" && pm2 delete "$id";;
    *) err "Ação inválida"; return 1;;
  esac
  pm2 save >/dev/null 2>&1
}

pm2_logs() {
  pm2_need || return 1
  local id m
  id=$(ask "Nome ou ID do app (vazio = todos)" "")
  m=$(ask "(1) Últimas 100 linhas  (2) Tempo real" 1)
  if [[ $m == 2 ]]; then follow pm2 logs $id; else pm2 logs $id --lines 100 --nostream; fi
}

# --------------------------------------------------------------------- Supervisor
sup_need() { has supervisorctl || { err "Supervisor não instalado (opção 13)"; return 1; }; }

sup_install() {
  if has supervisorctl; then info "Supervisor já instalado"
  else info "Instalando Supervisor..."; apt_i supervisor >/dev/null || { err "Falha ao instalar"; return 1; }; fi
  systemctl enable --now supervisor >/dev/null 2>&1
  ok "Supervisor ativo ($(supervisorctl version 2>/dev/null))"
}

sup_conf_of() { # arquivo .conf que contém o programa
  local base="${1%%:*}" f
  for f in /etc/supervisor/conf.d/*.conf; do
    [[ -f $f ]] && grep -q "^\[program:$base\]" "$f" && { echo "$f"; return 0; }
  done
  return 1
}

sup_create() {
  sup_need || return 1
  title "Criar worker no Supervisor"
  local name t dir cmd user n=1 php extra conf defuser=www-data
  name=$(ask "Nome do worker (ex: meusite-fila)")
  [[ $name =~ ^[A-Za-z0-9_-]+$ ]] || { err "Nome inválido (use letras, números, - e _)"; return 1; }
  conf="/etc/supervisor/conf.d/$name.conf"
  { [[ -f $conf ]] || sup_conf_of "$name" >/dev/null; } && { err "Worker '$name' já existe"; return 1; }
  echo "  (1) Laravel - queue:work"
  echo "  (2) Laravel - schedule:work"
  echo "  (3) Laravel - Horizon"
  echo "  (4) Comando livre"
  t=$(ask "Tipo" 1)
  case $t in
    1|2|3)
      dir=$(ask "Pasta do projeto Laravel" "$WWW/"); dir="${dir%/}"
      [[ -f $dir/artisan ]] || { err "artisan não encontrado em $dir"; return 1; }
      php=$(pick_php_bin)
      case $t in
        1) extra=$(ask "Parâmetros extras (ex: --queue=high,default) - opcional" "")
           cmd="$php $dir/artisan queue:work --sleep=3 --tries=3 --max-time=3600${extra:+ $extra}"
           n=$(ask "Quantidade de processos" 1);;
        2) cmd="$php $dir/artisan schedule:work";;
        3) cmd="$php $dir/artisan horizon";;
      esac;;
    4) dir=$(ask "Pasta de trabalho" "/root")
       cmd=$(ask "Comando completo")
       [[ -n $cmd ]] || { err "Comando vazio"; return 1; }
       n=$(ask "Quantidade de processos" 1)
       defuser=root;;
    *) err "Tipo inválido"; return 1;;
  esac
  [[ $n =~ ^[0-9]+$ ]] && ((n >= 1)) || n=1
  user=$(ask "Rodar como usuário" "$defuser")
  id "$user" >/dev/null 2>&1 || { err "Usuário $user não existe"; return 1; }
  cat > "$conf" <<EOF
; Worker $name - gerado por LK em $(date '+%F %T')
[program:$name]
process_name=%(program_name)s_%(process_num)02d
command=$cmd
directory=$dir
user=$user
numprocs=$n
autostart=true
autorestart=true
stopasgroup=true
killasgroup=true
redirect_stderr=true
stdout_logfile=/var/log/supervisor/$name.log
stdout_logfile_maxbytes=20MB
stdout_logfile_backups=3
stopwaitsecs=3600
EOF
  supervisorctl reread >/dev/null; supervisorctl update >/dev/null
  sleep 1; supervisorctl status "$name:*"
  ok "Worker '$name' criado (log: /var/log/supervisor/$name.log)"
}

sup_manage() {
  sup_need || return 1
  title "Workers do Supervisor"
  supervisorctl status; echo
  local name a target f
  name=$(ask "Nome do worker (all = todos)")
  [[ -n $name ]] || return 0
  target="$name:*"; [[ $name == all || $name == *:* ]] && target="$name"
  echo "  (1) Reiniciar  (2) Parar  (3) Iniciar  (4) Ver log  (5) Remover worker"
  a=$(ask "Ação" 1)
  case $a in
    1) supervisorctl restart "$target";;
    2) supervisorctl stop "$target";;
    3) supervisorctl start "$target";;
    4) view_log "/var/log/supervisor/${name%%:*}.log";;
    5) [[ $name == all ]] && { err "Informe um worker específico"; return 1; }
       f=$(sup_conf_of "$name") || { err "Configuração de '$name' não encontrada"; return 1; }
       confirm "Remover o worker '${name%%:*}' ($f)?" || return 1
       supervisorctl stop "${name%%:*}:*" >/dev/null 2>&1
       rm -f "$f"; supervisorctl reread >/dev/null; supervisorctl update >/dev/null
       ok "Worker removido";;
    *) err "Ação inválida"; return 1;;
  esac
}

# --------------------------------------------------------------------- Firewall / IPs
is_v6() { [[ $1 == *:* ]]; }
valid_ip() {
  local ip="$1" o
  if [[ $ip =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})(/([0-9]{1,2}))?$ ]]; then
    for o in 1 2 3 4; do ((10#${BASH_REMATCH[o]} <= 255)) || return 1; done
    [[ -z ${BASH_REMATCH[6]} ]] || ((10#${BASH_REMATCH[6]} >= 1 && 10#${BASH_REMATCH[6]} <= 32)) || return 1
    return 0
  fi
  [[ $ip == *:* && $ip =~ ^[0-9A-Fa-f:]+(/[0-9]{1,3})?$ ]]
}

blocked_count() { local c=0; [[ -f $LK_BLOCKLIST ]] && c=$(grep -cvE '^[[:space:]]*(#|$)' "$LK_BLOCKLIST"); echo "${c:-0}"; }
is_blocked()    { [[ -f $LK_BLOCKLIST ]] && awk '{print $1}' "$LK_BLOCKLIST" | grep -qxF "$1"; }

fw_init() {
  has ipset    || apt_i ipset >/dev/null 2>&1    || { err "Não foi possível instalar ipset"; return 1; }
  has iptables || apt_i iptables >/dev/null 2>&1 || { err "Não foi possível instalar iptables"; return 1; }
  ipset -exist create lk_block4 hash:net family inet
  ipset -exist create lk_block6 hash:net family inet6
  iptables -C INPUT -m set --match-set lk_block4 src -j DROP 2>/dev/null \
    || iptables -I INPUT 1 -m set --match-set lk_block4 src -j DROP
  if has ip6tables; then
    ip6tables -C INPUT -m set --match-set lk_block6 src -j DROP 2>/dev/null \
      || ip6tables -I INPUT 1 -m set --match-set lk_block6 src -j DROP
  fi
  # containers Docker (Evolution API etc.)
  if iptables -nL DOCKER-USER >/dev/null 2>&1; then
    iptables -C DOCKER-USER -m set --match-set lk_block4 src -j DROP 2>/dev/null \
      || iptables -I DOCKER-USER 1 -m set --match-set lk_block4 src -j DROP
  fi
}

block_ip() {
  local ip="${1:-}" reason="${2:-}" me set
  [[ -z $ip ]] && ip=$(ask "IP ou faixa para bloquear (ex: 1.2.3.4 ou 1.2.3.0/24)")
  valid_ip "$ip" || { err "IP inválido: $ip"; return 1; }
  me=$(awk '{print $1}' <<< "${SSH_CLIENT:-}")
  if [[ -n $me && $ip == "$me" ]]; then
    warn "Esse é o SEU IP atual de SSH ($me)!"
    confirm "Bloquear mesmo assim? Você vai perder o acesso" || return 1
  fi
  [[ -z $reason && -z $LK_CLI ]] && reason=$(ask "Motivo (opcional)" "")
  fw_init || return 1
  set=lk_block4; is_v6 "$ip" && set=lk_block6
  ipset -exist add "$set" "$ip" || { err "Falha ao bloquear $ip"; return 1; }
  is_blocked "$ip" || echo "$ip # $(date '+%F %T')${reason:+ - $reason}" >> "$LK_BLOCKLIST"
  has conntrack && conntrack -D -s "${ip%%/*}" >/dev/null 2>&1
  ok "IP $ip bloqueado"
}

list_blocked() {
  title "IPs bloqueados"
  if [[ $(blocked_count) -eq 0 ]]; then info "Nenhum IP bloqueado"; return 1; fi
  grep -vE '^[[:space:]]*(#|$)' "$LK_BLOCKLIST" | nl -w3 -s') '
}

unblock_ip() {
  local ip="${1:-}" set
  if [[ -z $ip ]]; then
    list_blocked || return 0
    ip=$(ask "Número da lista ou IP para liberar")
    if [[ $ip =~ ^[0-9]+$ ]]; then
      ip=$(grep -vE '^[[:space:]]*(#|$)' "$LK_BLOCKLIST" | sed -n "${ip}p" | awk '{print $1}')
    fi
  fi
  [[ -n $ip ]] || { err "Nada selecionado"; return 1; }
  is_blocked "$ip" || warn "$ip não estava na lista do LK (tentando remover do firewall/fail2ban mesmo assim)"
  set=lk_block4; is_v6 "$ip" && set=lk_block6
  ipset -exist del "$set" "$ip" 2>/dev/null
  if [[ -f $LK_BLOCKLIST ]]; then
    awk -v ip="$ip" '$1 != ip' "$LK_BLOCKLIST" > "$LK_BLOCKLIST.tmp" && mv "$LK_BLOCKLIST.tmp" "$LK_BLOCKLIST"
  fi
  has fail2ban-client && fail2ban-client unban "$ip" >/dev/null 2>&1
  ok "IP $ip liberado"
}

fw_restore() {
  fw_init || return 1
  ipset flush lk_block4; ipset flush lk_block6
  local ip n=0
  [[ -f $LK_BLOCKLIST ]] || return 0
  while read -r ip _; do
    [[ -z $ip || $ip == \#* ]] && continue
    if is_v6 "$ip"; then ipset -exist add lk_block6 "$ip"; else ipset -exist add lk_block4 "$ip"; fi && ((n++))
  done < "$LK_BLOCKLIST"
  ok "$n IP(s) bloqueados restaurados no firewall"
}

ssh_attackers() {
  title "Top IPs com falha de login SSH"
  local src data me min ip cnt n=0
  if [[ -r /var/log/auth.log ]]; then src=$(cat /var/log/auth.log /var/log/auth.log.1 2>/dev/null)
  else src=$(journalctl -u ssh -u sshd --since "7 days ago" --no-pager 2>/dev/null); fi
  data=$(grep -E "Failed password|Invalid user|authentication failure|Connection closed by authenticating user|maximum authentication attempts" <<< "$src" \
         | grep -oE '([0-9]{1,3}\.){3}[0-9]{1,3}' | sort | uniq -c | sort -rn | head -n 20)
  [[ -n $data ]] || { ok "Nenhuma tentativa de invasão encontrada"; return 0; }
  printf "  %-10s %s\n" "Tentativas" "IP"
  while read -r cnt ip; do
    if is_blocked "$ip"; then printf "  %-10s %s %s(bloqueado)%s\n" "$cnt" "$ip" "$D" "$N"
    else printf "  %-10s %s\n" "$cnt" "$ip"; fi
  done <<< "$data"
  echo
  min=$(ask "Bloquear todos com N ou mais tentativas (0 = não bloquear)" 0)
  [[ $min =~ ^[0-9]+$ ]] && ((min > 0)) || return 0
  me=$(awk '{print $1}' <<< "${SSH_CLIENT:-}")
  while read -r cnt ip; do
    ((cnt >= min)) || continue
    [[ $ip == "$me" ]] && { warn "Pulando seu próprio IP $ip"; continue; }
    is_blocked "$ip" && continue
    block_ip "$ip" "ssh brute force ($cnt tentativas)" && ((n++))
  done <<< "$data"
  ok "$n IP(s) bloqueados"
}

ssh_port() { local p; p=$(sshd -T 2>/dev/null | awk '/^port /{print $2; exit}'); echo "${p:-22}"; }

fw_menu() {
  title "Firewall (UFW)"
  if ! has ufw; then
    warn "UFW não instalado"
    confirm_yes "Instalar UFW?" || return 0
    apt_i ufw >/dev/null || { err "Falha ao instalar UFW"; return 1; }
  fi
  ufw status verbose 2>/dev/null | head -n 30
  echo
  echo "  (1) Abrir porta     (2) Fechar porta     (3) Permitir IP (acesso total)"
  echo "  (4) Ativar UFW      (5) Desativar UFW"
  local o p ip sp ap
  o=$(ask "Opção")
  case $o in
    1) p=$(ask "Porta (ex: 3000, 3000/tcp, 8000:8100/tcp)"); [[ -n $p ]] && ufw allow "$p" && ok "Porta $p aberta";;
    2) p=$(ask "Porta a fechar"); [[ -n $p ]] && ufw delete allow "$p" && ok "Porta $p fechada";;
    3) ip=$(ask "IP"); valid_ip "$ip" || { err "IP inválido"; return 1; }
       ufw allow from "$ip" && ok "Acesso total liberado para $ip";;
    4) sp=$(ssh_port)
       ufw allow "$sp/tcp" >/dev/null && info "SSH (porta $sp) liberado"
       if apache_svc >/dev/null || svc_has nginx; then ufw allow 80,443/tcp >/dev/null && info "HTTP/HTTPS liberados"; fi
       if is_aapanel && [[ -f /www/server/panel/data/port.pl ]]; then
         ap=$(tr -dc '0-9' < /www/server/panel/data/port.pl); [[ -n $ap ]] && ufw allow "$ap/tcp" >/dev/null && info "aaPanel (porta $ap) liberado"
       fi
       ufw --force enable && ok "UFW ativado";;
    5) confirm "Desativar o firewall UFW?" && ufw disable;;
    *) return 0;;
  esac
}

