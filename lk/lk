  lk site off <domínio>      desliga o site (mantém os arquivos)
  lk sites                   lista sites
  lk ssl <domínio>           emite SSL Let's Encrypt
  lk db add [nome]           cria banco + usuário
  lk db del [nome]           remove banco
  lk db list                 lista bancos
  lk backup <site>|all       backup do site (arquivos + banco) em /var/backups/lkmonitor
  lk backups [site]          lista os backups
  lk restore <site> <arq>    restaura um backup (faz antes um backup de segurança)
  lk lamp                    instala LAMP
  lk default-page            configura a página default do servidor
  lk monitor                 painel web (LK Monitor)
  lk ssh                     status e opções do SSH
  lk servidor [on|off] [agora|reiniciar|boot]
                             modo servidor (sem área de trabalho, tela apagada)
  lk tela [off|on]           apagar / acender a tela agora
  lk bot [on|off|teste]      liga / desliga o bot do WhatsApp (Guardião LK)
  lk ip-fixo [on|IP|off|status] IP fixo na rede de casa (on = .200; se ocupado, .201, .202...)
  lk apache-443 [off|status]  Apache e Tailscale Funnel juntos na porta 443 (automático com o Tailscale)
  lk whatsapp [instalar|info|guardiao|senha|remover]
                             WhatsApp no servidor: instala, números do bot, página do QR code
  lk temp                    temperatura da CPU
  lk 2fa [off]               status / desliga o login com 2 fatores do painel (perdeu o celular)
  lk setup                   instala tudo sem perguntas (LAMP + painel, senha temporária)
  lk senha                   nova senha do painel (Enter = temporária, trocada no 1º login)
  lk version                 versão
EOF
}

cli() {
  LK_CLI=1
  case "$1" in
    help|-h|--help) usage;;
    version|-v|--version) echo "LK v$LK_VERSION";;
    menu) main_menu;;
    status) show_status;;
    info) server_info;;
    restart)
      case "${2:-all}" in
        apache|apache2|httpd) restart_apache;;
        mysql|mariadb|db)     restart_db;;
        php|fpm|php-fpm)      restart_php;;
        all|lamp)             restart_lamp;;
        pm2)                  pm2_need && pm2 restart all;;
        *)                    svc_restart "$2";;
      esac;;
    block)   [[ -n ${2:-} ]] || { err "Uso: lk block <ip> [motivo]"; return 1; }; block_ip "$2" "${*:3}";;
    unblock) [[ -n ${2:-} ]] || { err "Uso: lk unblock <ip>"; return 1; }; unblock_ip "$2";;
    blocked) list_blocked;;
    fw-restore) fw_restore;;
    site)
      case "${2:-list}" in
        add) site_add "${3:-}";;
        del|rm|remove) site_del "${3:-}";;
        on|ligar) if [[ -n ${3:-} ]]; then site_enable "$3"; else LK_CLI=""; site_toggle; fi;;
        off|desligar) if [[ -n ${3:-} ]]; then site_disable "$3"; else LK_CLI=""; site_toggle; fi;;
        *) site_list;;
      esac;;
    sites) site_list;;
    ssl) ssl_issue "${2:-}";;
    db)
      case "${2:-list}" in
        add|create) db_create "${3:-}";;
        del|rm|drop) db_drop "${3:-}";;
        *) db_list;;
      esac;;
    backup)  [[ -n ${2:-} ]] || { err "Uso: lk backup <site>|all"; return 1; }; lkm_job --backup "$2";;
    backups) lkm_job --list "${2:-}";;
    restore)
      [[ -n ${2:-} && -n ${3:-} ]] || { err "Uso: lk restore <site> <arquivo>  (veja os arquivos com: lk backups <site>)"; return 1; }
      confirm "Restaurar $2 a partir de $3? Os arquivos e o banco voltam a esse ponto (antes é feito um backup de segurança)" || return 1
      lkm_job --restore "$2" "$3";;
    lamp) install_lamp;;
    monitor|painel) LK_CLI=""; monitor_menu;;
    ssh) LK_CLI=""; ssh_menu;;
    servidor|server)
      case "${2:-}" in
        on|ligar) LK_CLI=""; LK_SM_NOW=$(sm_when "${3:-}") server_mode_on;;
        off|desligar|normal) LK_CLI=""; LK_SM_NOW=$(sm_when "${3:-}") server_mode_off;;
        status) server_mode_status;;
        *) LK_CLI=""; server_mode_menu;;
      esac;;
    bot)
      case "${2:-status}" in on|ligar) bot_set 1;; off|desligar) bot_set 0;; teste|test) php /opt/lk-guard/guard.php teste;; *) bot_status;; esac;;
    proxy-https) apache_proxy_https && ok "Sites atrás do Tailscale Funnel / Cloudflare Tunnel: PHP recebe HTTPS=on";;
    ip-fixo|ipfixo)
      case "${2:-}" in on|ligar) ipfix_on;; off|desligar|dhcp) ipfix_off;; status) ipfix_status;; "") LK_CLI=""; ipfix_menu;; *) ipfix_on "$2";; esac;;
    apache-443)
      case "${2:-on}" in off|desligar) apache_443_off;; status) apache_443_on && { ok "Apache escuta a 443 fora do Tailscale:"; cat "$A443_CONF"; } || warn "Apache usa Listen 443 (todos os IPs)";; *) apache_443_fix force;; esac;;
    whatsapp|wa)
      case "${2:-}" in
        ""|instalar|install|atualizar|update) wa_run;;
        remover|uninstall) wa_run uninstall;;
        info|senha|guardiao|lk) wa_run "$2";;
        *) err "Uso: lk whatsapp [instalar|info|guardiao|senha|remover]"; return 1;;
      esac;;
    tela|screen)
      case "${2:-off}" in on|ligar|acender) screen_on;; *) screen_off;; esac;;
    temp|temperatura) echo "CPU: $(cpu_temp)";;
    2fa)
      case "${2:-status}" in
        off|desligar) rm -f /var/lib/lkmonitor/2fa.json && ok "2FA do painel desligado. Entre só com a senha e ative de novo na aba Internet.";;
        *) if [[ -f /var/lib/lkmonitor/2fa.json ]] && grep -q '"enabled": true' /var/lib/lkmonitor/2fa.json; then ok "2FA do painel: LIGADO"; else warn "2FA do painel: desligado"; fi;;
      esac;;
    setup|instalar) lk_setup;;
    senha|password|passwd)
      [[ -f $LKM_INSTALLER ]] || { err "Instalador do painel não encontrado. Rode o install-lk.sh mais recente."; return 1; }
      bash "$LKM_INSTALLER" senha;;
    default-page) create_default_page;;
    *) err "Comando desconhecido: $1"; usage; return 1;;
  esac
}

# --------------------------------------------------------------------- início
load_os
case "${1:-}" in
  help|-h|--help|version|-v|--version) cli "$@"; exit $?;;
esac
if [[ $EUID -ne 0 ]]; then
  if command -v sudo >/dev/null 2>&1; then exec sudo bash "$(readlink -f "$0")" "$@"; fi
  echo "${R}Execute como root${N}"; exit 1
fi
mkdir -p "$LK_DIR"; chmod 700 "$LK_DIR"; touch "$LK_BLOCKLIST"
if [[ $# -eq 0 ]]; then main_menu; else cli "$@"; fi
